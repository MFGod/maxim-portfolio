# Что не отправлять на сборку.
#
# Vercel CLI не читает .gitignore при загрузке из локальной папки: первый же
# деплой потащил 42 МБ и оборвался на середине. Список нужен только для
# деплоя из CLI — сборке из GitHub он не мешает, там этих файлов и так нет.

# Геометрия мира: 20 МБ, живут на отдельном хостинге, адрес приходит из
# NEXT_PUBLIC_WORLD_ASSETS_URL. В сборке они не нужны.
public/world

# Оригиналы и варианты карты: рабочие материалы, к сборке отношения не имеют.
world-assets

# Рабочие материалы и обвязка агентов.
docs
scripts
.claude
.cursor
.playwright-mcp
