# Публичный адрес сайта. Используется для canonical, Open Graph и sitemap.
# На Vercel задаётся в настройках проекта; локально можно не выставлять.
NEXT_PUBLIC_SITE_URL=https://maxim-zhikharev.vercel.app

# Откуда браузер берёт геометрию мира. Пусто — public/world рядом с приложением.
NEXT_PUBLIC_WORLD_ASSETS_URL=https://mfgod.github.io/maxim-zhikharev.assets/world

# ОБЯЗАТЕЛЕН в проде: без него аркада вернёт ошибку. openssl rand -base64 32
ARCADE_SECRET=

# Без них рекорды живут в памяти инстанса и теряются между запросами.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
